---
import Base from "../layouts/Base.astro";
import Tabs from "../components/Tabs.astro";
import Input from "../components/Input.astro";
import Badge from "../components/Badge.astro";
import { posts } from "../data/posts";

const tabs = [
  { value: "all", label: "all", count: posts.length },
  { value: "maths", label: "maths" },
  { value: "data", label: "data" },
  { value: "web", label: "web" },
];
---

<Base
  active="writing"
  title="writing — quentin vanderlinden"
  description="Notes from the middle of the work — applied maths, data, and shipping fullstack software."
>
  <div class="wrap" style="padding-top:var(--space-16)">
    <span class="eyebrow">writing</span>
    <h1 style="font:var(--type-display);font-size:clamp(30px,7vw,49px);margin-top:12px;max-width:20ch">
      Notes from the middle of the work
    </h1>
    <p class="lede">
      Mostly applied maths, data, and the fullstack in between.
    </p>

    <div
      style="display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:var(--space-12);flex-wrap:wrap"
    >
      <Tabs tabs={tabs} value="all" />
      <Input size="sm" icon="search" placeholder="Search posts" id="post-search" style="width:220px" />
    </div>

    <div style="margin-top:var(--space-6)" id="post-list">
      {
        posts.map((p) => (
          <div class="post" data-tag={p.tag} data-title={p.title.toLowerCase()}>
            <div style="display:flex;flex-direction:column;gap:6px">
              <span class="post__title">{p.title}</span>
              <span class="work__meta">{p.month} · {p.readingTime}</span>
            </div>
            <Badge tone="neutral">{p.tag}</Badge>
          </div>
        ))
      }
      <p
        id="post-empty"
        style="display:none;font:var(--type-body-sm);color:var(--text-muted);padding:var(--space-8) 0"
      >
        Nothing matches “<span id="post-empty-q"></span>”.
      </p>
    </div>
  </div>
</Base>

<script>
  // Live tab filter + search over the writing list (mirrors the source's
  // React state: active tab AND case-insensitive title match).
  const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
  const search = document.getElementById("post-search") as HTMLInputElement | null;
  const posts = Array.from(document.querySelectorAll<HTMLElement>("#post-list .post"));
  const empty = document.getElementById("post-empty");
  const emptyQ = document.getElementById("post-empty-q");

  let tab = "all";
  let q = "";

  function apply() {
    let visible = 0;
    for (const el of posts) {
      const matchesTab = tab === "all" || el.dataset.tag === tab;
      const matchesQ = (el.dataset.title || "").includes(q.toLowerCase());
      const show = matchesTab && matchesQ;
      el.style.display = show ? "" : "none";
      if (show) visible++;
    }
    if (empty && emptyQ) {
      empty.style.display = visible === 0 ? "" : "none";
      emptyQ.textContent = q;
    }
  }

  tablist?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>(".qv-tabs__tab");
    if (!btn) return;
    tab = btn.dataset.tab || "all";
    for (const t of tablist.querySelectorAll<HTMLElement>(".qv-tabs__tab")) {
      t.setAttribute("aria-selected", String(t === btn));
    }
    apply();
  });

  search?.addEventListener("input", () => {
    q = search.value;
    apply();
  });
</script>
