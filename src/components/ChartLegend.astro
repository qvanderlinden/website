---
/** ChartLegend — mirrors the design system ChartLegend. */
interface Props {
  items?: { label: string; color?: string }[];
  class?: string;
  [key: string]: unknown;
}
const { items = [], class: className, ...rest } = Astro.props;
---

<div class:list={["qv-legend", className]} {...rest}>
  {
    items.map((it, i) => (
      <span class="qv-legend__item">
        <span
          class="qv-legend__swatch"
          style={`background:${it.color || `var(--chart-${(i % 6) + 1})`}`}
        />
        {it.label}
      </span>
    ))
  }
</div>
