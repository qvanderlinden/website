---
/**
 * Icon — renders a Lucide glyph as inline SVG at build time (via astro-icon).
 * Mirrors the design system's Icon: 24x24 viewBox, currentColor stroke,
 * 1.75 stroke width, round caps/joins.
 */
import { Icon as AstroIcon } from "astro-icon/components";

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  color?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  name,
  size = 16,
  strokeWidth = 1.75,
  color,
  class: className,
  ...rest
} = Astro.props;
---

<AstroIcon
  name={`lucide:${name}`}
  width={size}
  height={size}
  stroke-width={strokeWidth}
  class:list={["qv-icon", className]}
  style={color ? `color:${color}` : undefined}
  {...rest}
/>
