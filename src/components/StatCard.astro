---
/** StatCard — mirrors the design system StatCard (a stat rendered on a card). */
import TrendValue from "./TrendValue.astro";

interface Props {
  label: string;
  value: string;
  delta?: number;
  deltaLabel?: string;
  footnote?: string;
  accent?: boolean;
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const {
  label,
  value,
  delta,
  deltaLabel,
  footnote,
  accent = false,
  class: className,
  style,
  ...rest
} = Astro.props;

const baseStyle = `padding:var(--card-pad);gap:var(--space-2);${accent ? "border-top-width:0;" : ""}${style ?? ""}`;
---

<div class:list={["qv-card", "qv-stat", className]} style={baseStyle} {...rest}>
  <span class="qv-stat__label">{label}</span>
  <div class="qv-stat__row">
    <span class="qv-stat__value" style={accent ? "color:var(--text-accent)" : undefined}>
      {value}
    </span>
    {delta != null && <TrendValue value={delta} label={deltaLabel} />}
  </div>
  {footnote && <span class="qv-stat__foot">{footnote}</span>}
  <slot />
</div>
