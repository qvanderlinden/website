---
/** Footer — the ink footer from the design system's Home composition. */
import Logo from "./Logo.astro";
---

<footer class="footer">
  <div
    class="wrap"
    style="display:flex;justify-content:space-between;gap:var(--space-10);flex-wrap:wrap"
  >
    <div>
      <Logo variant="vertical" cell={7} tone="cream" showTagline />
    </div>
    <div class="footer-cols" style="display:flex;gap:var(--space-16);font:var(--type-body-sm)">
      <div style="display:flex;flex-direction:column;gap:8px">
        <span class="eyebrow" style="color:var(--ink-400)">elsewhere</span>
        <a href="https://github.com" rel="me">github</a>
        <a href="https://linkedin.com" rel="me">linkedin</a>
        <a href="/rss.xml">rss</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <span class="eyebrow" style="color:var(--ink-400)">get in touch</span>
        <a href="mailto:contact@quentinvanderlinden.dev">contact@quentinvanderlinden.dev</a>
        <span style="color:var(--ink-400)">Gesves, Belgium · CET</span>
      </div>
    </div>
  </div>
  <div
    class="wrap"
    style="margin-top:var(--space-12);font:var(--type-mono);font-size:var(--text-xs);color:var(--ink-400)"
  >
    © 2026 quentin vanderlinden · gesves, belgium
  </div>
</footer>

<style>
  .footer-cols {
    flex-wrap: wrap;
  }
  /* Long email shouldn't force horizontal scroll on narrow phones. */
  .footer-cols a {
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .footer-cols {
      gap: var(--space-8);
    }
  }
</style>
